---
import "../styles/global.css";
import { site, isLive } from "../config/site";

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = "/" } = Astro.props;
const base = Astro.site ?? new URL(site.url);
const canonical = new URL(path, base).toString();

/**
 * PNG, not SVG. Every social and preview crawler — Facebook, LinkedIn, X,
 * Slack, Discord, iMessage, WhatsApp — fetches the image server-side and none
 * of them rasterise SVG, so the previous `og.svg` produced a blank card
 * everywhere it was shared. Generated by `scripts/build-og.mjs`.
 */
const ogImage = new URL("/og.png", base).toString();
const ogAlt = "thalamus — the fully extensible, self-hosted agentic OS";

/**
 * One `@graph` rather than several script blocks, so entities can reference
 * each other by `@id`. Google treats both identically.
 *
 * Two deliberate omissions:
 *  - **No `aggregateRating`.** Google's Software-app rich result needs a rating
 *    or review, so this page is not eligible for it. Inventing one to qualify
 *    is a structured-data policy violation. The markup stays honest and the
 *    rich result is forgone.
 *  - **No `SearchAction`.** The sitelinks searchbox was retired in Nov 2024.
 *
 * `codeRepository` and `sameAs` are the highest-value properties here: "thalamus"
 * is a brain structure with an enormous prior, so the graph has to state plainly
 * which entity this is and what else on the web is the same thing.
 */
const repoLive = isLive("github");

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site.url}/#organization`,
      name: site.name,
      url: `${site.url}/`,
      description:
        "The fully extensible, self-hosted agentic OS. Every capability is a plugin; every coding agent is a swappable engine.",
      logo: {
        "@type": "ImageObject",
        "@id": `${site.url}/#logo`,
        url: `${site.url}/logo-512.png`,
        width: 512,
        height: 512,
        caption: site.name,
      },
      founder: { "@type": "Person", name: site.author },
      ...(repoLive ? { sameAs: [site.repo] } : {}),
    },
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: `${site.url}/`,
      name: site.name,
      description,
      publisher: { "@id": `${site.url}/#organization` },
      inLanguage: "en",
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${site.url}/#software`,
      name: site.name,
      // Old terms stay as invisible retrieval hooks. They are no longer the
      // label, but people who know them should still land here.
      alternateName: ["openthalamus", "thalamus agentic OS", "thalamus control plane"],
      applicationCategory: "DeveloperApplication",
      applicationSubCategory: "Agentic operating system — AI agent orchestration",
      operatingSystem: "Linux, macOS",
      description,
      url: canonical,
      softwareVersion: "0",
      dateModified: site.lastUpdated,
      license: site.licenseUrl,
      isAccessibleForFree: true,
      author: { "@id": `${site.url}/#organization` },
      publisher: { "@id": `${site.url}/#organization` },
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        availability: "https://schema.org/PreOrder",
      },
      featureList: [
        "Fully extensible — every capability above the kernel is a plugin",
        "One memory that survives sessions and engine swaps",
        "One trust gate that classifies every action before it runs",
        "Durable jobs that outlive restarts",
        "Swappable coding engines behind a driver port",
        "Ten-noun kernel; drivers for memory, model, transport and storage",
        "Append-only action log",
        "Spend caps per run",
      ],
      keywords:
        "agentic OS, agent operating system, extensible, plugin architecture, AI agent orchestration, coding agent control plane, agent memory layer, self-hosted, meta-harness, Claude Code, Codex, opencode",
      ...(repoLive ? { codeRepository: site.repo, sameAs: [site.repo] } : {}),
    },
    {
      "@type": "SoftwareSourceCode",
      "@id": `${site.url}/#sourcecode`,
      name: site.name,
      programmingLanguage: "TypeScript",
      runtimePlatform: "Node.js",
      license: site.licenseUrl,
      about: { "@id": `${site.url}/#software` },
      ...(repoLive ? { codeRepository: site.repo } : {}),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/*
      `max-snippet:-1` is the load-bearing one: Google documents that max-snippet
      also caps how much of a page may be used as direct input to AI Overviews
      and AI Mode, and -1 means "no limit, you choose". max-image-preview:large
      is what allows a full-size image in the result.
    */}
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />

    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* The only third-party origin on the page — the Turnstile widget. */}
    <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <a class="skip" href="#what">Skip to what thalamus is</a>
    <slot />
  </body>
</html>

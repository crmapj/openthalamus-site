---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Definition from "../components/Definition.astro";
import BeatAlive from "../components/BeatAlive.astro";
import BeatGrow from "../components/BeatGrow.astro";
import BeatKernel from "../components/BeatKernel.astro";
import Questions from "../components/Questions.astro";
import Close from "../components/Close.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config/site";

const title = "thalamus — the fully extensible, self-hosted agentic OS";
---

<Base title={title} description={site.description}>
  <Nav />

  <main id="beats">
    <Hero />
    <Definition />
    <BeatAlive />
    <BeatGrow />
    <BeatKernel />
    <Questions />
    <Close />
  </main>

  <Footer />
</Base>

<script>
  import { initBeats } from "../scripts/beats";

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ── The pinned scroll beats ─────────────────────────────────────────────
     Motion is opt-in and the engine decides for itself whether it can run.
     Everything is already visible before this line executes. */
  try {
    initBeats();
  } catch (err) {
    // A broken animation must never cost the visitor the content. The CSS
    // resting state is the fully composed page, so swallowing this is safe.
    console.error("beats engine failed; static composition retained", err);
  }

  /* ── Reveal-on-scroll for the beat copy ──────────────────────────────────
     Same rule as the beats: only hide something once we have proven we can
     show it again. `.reveal` has no hidden state in CSS unless <html> carries
     `motion`, which only the engine sets. */
  const revealTargets = Array.from(document.querySelectorAll<HTMLElement>(".reveal"));
  if (!reduced && "IntersectionObserver" in window && revealTargets.length) {
    const showAll = () => revealTargets.forEach((el) => el.classList.add("in"));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("in");
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: "200px 0px -5% 0px", threshold: 0.01 },
    );
    revealTargets.forEach((el) => io.observe(el));
    // Failsafe: anything not reached shortly after load is shown regardless.
    setTimeout(showAll, 900);
    window.addEventListener("beforeprint", showAll);
  } else {
    revealTargets.forEach((el) => el.classList.add("in"));
  }

  /* ── Copy the install command (only rendered once install goes live) ───── */
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        const was = btn.textContent;
        btn.textContent = "Copied";
        setTimeout(() => (btn.textContent = was), 1600);
      } catch {
        /* clipboard denied — the command is visible and selectable anyway */
      }
    });
  });

  /* ── Turnstile, loaded late but never too late ───────────────────────────
     The widget is the only third-party script on the page, so it stays off the
     initial load. But the endpoint rejects a submission with no token, so it
     cannot simply be lazy: it loads two viewports before the form is reached,
     on any interaction with the form, and the submit handler waits briefly for
     a token if one has not arrived yet. */
  const siteKey = document.querySelector(".cf-turnstile")?.getAttribute("data-sitekey");
  let turnstileRequested = false;

  function loadTurnstile() {
    if (turnstileRequested || !siteKey) return;
    turnstileRequested = true;
    const s = document.createElement("script");
    s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
    s.async = true;
    s.defer = true;
    document.head.appendChild(s);
  }

  const waitlistEl = document.getElementById("waitlist");
  if (siteKey && waitlistEl) {
    if ("IntersectionObserver" in window) {
      const tio = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            loadTurnstile();
            tio.disconnect();
          }
        },
        { rootMargin: "200% 0px" },
      );
      tio.observe(waitlistEl);
    } else {
      loadTurnstile();
    }
    waitlistEl.addEventListener("pointerdown", loadTurnstile, { once: true });
    waitlistEl.addEventListener("focusin", loadTurnstile, { once: true });
  }

  /** Turnstile solves invisibly in well under a second; this is a backstop for
      someone who deep-links to #waitlist and submits immediately. */
  async function awaitToken(form: HTMLFormElement, ms = 4000): Promise<void> {
    if (!siteKey) return;
    const deadline = Date.now() + ms;
    while (Date.now() < deadline) {
      const field = form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]');
      if (field?.value) return;
      await new Promise((r) => setTimeout(r, 120));
    }
  }

  /* ── Attribution ─────────────────────────────────────────────────────────
     Captured on arrival and stashed, because the visitor scrolls ~11,000px
     before reaching the form and an in-page anchor would otherwise be the last
     thing `document.referrer` reports. Answer engines are the channel that
     matters for this product and most of them send no UTM at all, so the
     referrer host is the real signal. */
  const ATTR_KEY = "thal.attr";
  type Attr = { ref: string; utm: string; landing: string };

  function captureAttribution(): Attr {
    try {
      const stored = sessionStorage.getItem(ATTR_KEY);
      if (stored) return JSON.parse(stored) as Attr;
    } catch {
      /* private mode — fall through and just use this pageview */
    }
    const params = new URLSearchParams(location.search);
    const utm = ["utm_source", "utm_medium", "utm_campaign", "ref", "source"]
      .map((k) => (params.get(k) ? `${k}=${params.get(k)}` : ""))
      .filter(Boolean)
      .join("&")
      .slice(0, 300);
    const attr: Attr = {
      // Same-origin referrers are navigation noise, not acquisition.
      ref: document.referrer && !document.referrer.startsWith(location.origin)
        ? document.referrer.slice(0, 300)
        : "",
      utm,
      landing: (location.pathname + location.search).slice(0, 300),
    };
    try {
      sessionStorage.setItem(ATTR_KEY, JSON.stringify(attr));
    } catch {
      /* ignore */
    }
    return attr;
  }

  const attr = captureAttribution();
  const setField = (id: string, v: string) => {
    const el = document.getElementById(id) as HTMLInputElement | null;
    if (el) el.value = v;
  };
  setField("f-ref", attr.ref);
  setField("f-utm", attr.utm);
  setField("f-landing", attr.landing);

  /* ── Waitlist form ───────────────────────────────────────────────────── */
  const form = document.getElementById("waitlist-form") as HTMLFormElement | null;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement | null;
  const result = document.getElementById("result");
  const rTitle = document.getElementById("result-title");
  const rBody = document.getElementById("result-body");
  const rReceipt = document.getElementById("result-receipt");
  const formErr = document.getElementById("form-err");
  const emailInput = document.getElementById("email") as HTMLInputElement | null;

  const COPY: Record<string, { title: string; body: string; receipt: string }> = {
    added: {
      title: "You're on the list.",
      body: "One email the day you can install it. Nothing else.",
      receipt: "added · one email at release",
    },
    already: {
      title: "You're already on the list.",
      body: "This address was added earlier — no need to submit again. You're all set.",
      receipt: "already on the list",
    },
  };

  /** Errors stay inline and leave the form alive to retry. */
  function showError(message: string) {
    if (!formErr) return;
    formErr.textContent = message;
    formErr.hidden = false;
  }
  function clearError() {
    if (formErr) formErr.hidden = true;
  }
  emailInput?.addEventListener("input", clearError);

  /** Success replaces the form in place — same grid cell, so nothing jumps. */
  function showResult(outcome: "added" | "already", email?: string) {
    if (!result || !rTitle || !rBody) return;
    const copy = COPY[outcome];
    clearError();
    result.setAttribute("data-outcome", outcome);
    rTitle.textContent = copy.title;
    rBody.textContent = copy.body;
    if (rReceipt) {
      const addr = (email ?? emailInput?.value ?? "").trim();
      rReceipt.textContent = addr ? `${addr} · ${copy.receipt}` : copy.receipt;
    }
    result.classList.add("show");
    form?.classList.add("form-hidden");
    result.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "center" });
  }

  if (form && btn) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!emailInput?.value.trim()) {
        showError("Enter an email address first.");
        emailInput?.focus();
        return;
      }
      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = "Adding…";
      try {
        loadTurnstile();
        await awaitToken(form);
        const res = await fetch("/api/waitlist", {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        const data = (await res.json().catch(() => ({}))) as Record<string, string>;
        if (res.ok && (data.outcome === "added" || data.outcome === "already")) {
          showResult(data.outcome);
        } else {
          showError(data.message || "That didn't go through. Check the address and try again.");
          if ((window as any).turnstile) (window as any).turnstile.reset();
        }
      } catch {
        showError("Network problem — try again in a moment.");
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  }

  // No-JS path returns with ?joined / ?already / ?error — honour it on load.
  const q = new URLSearchParams(location.search);
  if (q.has("joined")) showResult("added");
  else if (q.has("already")) showResult("already");
  else if (q.has("error")) showError("That didn't go through. Check the address and try again.");
</script>

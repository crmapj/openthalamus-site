---
import Mark from "./Mark.astro";
import BrandMark from "./BrandMark.astro";

/**
 * The dissection — FIG. 1.
 *
 * The designer's answer to the question the name keeps raising. A brain
 * assembles out of particles, the cortex blows away, then the cerebellum, and
 * what is left in the middle is the thalamus: the relay everything else
 * depends on. Then it grows nerves down to four harnesses and lands on
 * "A kernel, not a cortex."
 *
 * This replaces three paragraphs and a ten-row spec table with one argument.
 * Those details did not vanish — they moved to the FAQ, where a question is
 * attached to each of them.
 *
 * Progressive enhancement is the whole game here. The canvas is decoration:
 * no crawler and no screen reader gets anything from it. Every word is real
 * DOM text, and the CSS resting state is the composed plate with all five
 * sections stacked and readable. `anatomy.ts` adds `html.anatomy-motion`, and
 * only then does anything hide or move. If the script never runs, this reads
 * as a normal article.
 */
const plates = [
  {
    num: "I",
    part: "The cortex",
    h: "The intelligence is rented.",
    p: "Brilliant, expensive, and swapped every season — Claude today, something smarter in spring. thalamus doesn't compete with the cortex. It assumes you'll keep replacing it.",
    in: "0.095,0.13",
    out: "0.235,0.27",
  },
  {
    num: "II",
    part: "The cerebellum",
    h: "Skill is installed.",
    p: "Coordination, routine, practiced motion. Here that's a plugin — pulled with one command, replaced without grief, written in an afternoon.",
    in: "0.285,0.315",
    out: "0.39,0.42",
  },
  {
    num: "III",
    part: "The thalamus",
    h: "What's left is the part worth owning.",
    p: "Nearly everything on its way to the cortex passes through here first. It routes, it gates, it remembers what mattered. Not the smartest part of a brain — the part the smart parts cannot work without.",
    in: "0.445,0.48",
    out: "0.60,0.635",
  },
  {
    num: "IV",
    part: "The brainstem",
    h: "Intention becomes motion.",
    p: "Decisions travel down the stem as jobs — scheduled, permissioned, logged on the way through. What climbs back up is memory.",
    in: "0.645,0.675",
    out: "0.75,0.78",
  },
  {
    num: "V",
    part: "The hands",
    h: "The hands are hired.",
    p: "Good hands, anyone's hands, swappable at the wrist. Every harness is an adapter behind one driver port, so switching leaves your memory, your history and your trust rules exactly where they were. The nervous system stays yours.",
    in: "0.795,0.83",
    out: "0.925,0.95",
  },
];

/* The ten kernel nouns, which ring the thalamus once it is the only thing
   left. Same list as the FAQ and llms.txt. */
const nouns = [
  "authority", "action log", "trust gate", "jobs", "memory port",
  "resource registry", "RPC registry", "plugin lifecycle", "clock", "settlement receipts",
];

const callouts = ["Cortex", "Cerebellum", "Thalamus", "Brainstem"];
/* The four the plate can fit. Marks are the same source as the relay beat and
   the plugin chips, so a harness looks the same everywhere on the page. */
const hands = [
  { name: "Claude Code", mark: "claude" },
  { name: "Codex", mark: "openai" },
  { name: "opencode", mark: "opencode" },
  { name: "Local model", mark: "ollama" },
];
const rail = ["Plate", "Cortex", "Cerebellum", "Thalamus", "Brainstem", "Hands"];
---

<section class="anatomy" id="anatomy" aria-labelledby="anatomy-h">
  <div class="shell an-prologue">
    <p class="eyebrow">Fig. 1 · A dissection</p>
    <h2 id="anatomy-h" class="an-title">The name is literal.</h2>
    <p class="an-lede">
      Every system claims to be a brain. Fine — let's take one apart and see which piece
      thalamus actually is.
    </p>
  </div>

  <div class="pin an-pin" data-anatomy>
    <div class="an-stage">
      {/* Decoration. Everything this draws is stated in the text beside it. */}
      <canvas class="an-canvas" aria-hidden="true"></canvas>

      <div class="an-plate-labels" aria-hidden="true">
        {callouts.map((c) => <span class="an-callout">{c}</span>)}
        {nouns.map((n) => <span class="an-noun">{n}</span>)}
        {
          hands.map((h) => (
            <div class="an-hand">
              <div class="an-hand-card">
                <span class="an-hand-name">
                  <BrandMark name={h.mark} tone="color" size={13} />
                  {h.name}
                </span>
                <span class="an-hand-state">waiting</span>
              </div>
            </div>
          ))
        }
      </div>

      <div class="an-copy-col">
        {
          plates.map((s) => (
            <article class="an-copy" data-in={s.in} data-out={s.out}>
              <p class="an-copy-num">{s.num} · {s.part}</p>
              <h3>{s.h}</h3>
              <p class="an-copy-body">{s.p}</p>
            </article>
          ))
        }
      </div>

      <p class="an-caption" aria-hidden="true">Fig. 1 · Sagittal section · approximate</p>
      <p class="an-hint" aria-hidden="true">Scroll to dissect</p>

      <div class="an-rail" aria-hidden="true">
        {rail.map((r) => <span class="an-rail-item">{r}</span>)}
      </div>

      <div class="an-payoff">
        <Mark class="an-payoff-mark" />
        <p class="an-payoff-h">A kernel, not a cortex.</p>
        <p class="an-payoff-sub">
          The part that routes, gates and remembers · on hardware you own
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* The resting state — no JavaScript, reduced motion, or a failed script.
     Everything readable, stacked, in order. The pin collapses, the stage stops
     being sticky, and the five plates become an ordinary prose column. */
  .anatomy {
    border-top: 1px solid var(--border-faint);
  }
  .an-prologue {
    padding-block: 108px 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .an-title {
    margin: 0;
    font-size: clamp(38px, 6.4vw, 68px);
    line-height: 1.05;
    font-weight: 650;
    letter-spacing: -0.042em;
    max-width: 820px;
  }
  .an-lede {
    margin: 0;
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 520px;
    text-wrap: pretty;
  }

  .an-pin {
    position: relative;
  }
  .an-stage {
    padding: 40px 0 96px;
  }
  .an-canvas,
  .an-plate-labels,
  .an-caption,
  .an-hint,
  .an-rail {
    display: none;
  }

  .an-copy-col {
    max-width: var(--shell, 1180px);
    margin: 0 auto;
    padding: 0 var(--gutter, 32px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 44px;
  }
  .an-copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .an-copy-num {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .an-copy h3 {
    margin: 0;
    font-size: clamp(24px, 2.4vw, 31px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.032em;
  }
  .an-copy-body {
    margin: 0;
    font-size: 15px;
    line-height: 1.62;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .an-payoff {
    max-width: var(--shell, 1180px);
    margin: 0 auto;
    padding: 76px var(--gutter, 32px) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    text-align: center;
  }
  .an-payoff-h {
    margin: 0;
    font-size: clamp(32px, 4.6vw, 54px);
    line-height: 1.06;
    font-weight: 650;
    letter-spacing: -0.038em;
  }
  .an-payoff-sub {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    max-width: 380px;
    line-height: 1.7;
  }

  /* ── The scrubbed state. Only reachable once the engine says so. ────── */
  :global(html.anatomy-motion) .an-pin {
    height: var(--an-vh, 780vh);
    border-top: 1px solid var(--border-faint);
    margin-top: 12vh;
  }
  :global(html.anatomy-motion) .an-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    padding: 0;
    background:
      radial-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px) 0 0 / 26px 26px;
  }
  :global(html.anatomy-motion) .an-canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  :global(html.anatomy-motion) .an-plate-labels {
    display: block;
  }

  :global(html.anatomy-motion) .an-copy-col {
    position: absolute;
    left: max(32px, 5.5%);
    top: 0;
    height: 100%;
    width: min(360px, 28vw);
    max-width: none;
    padding: 0;
    margin: 0;
    display: block;
    z-index: 5;
    pointer-events: none;
  }
  :global(html.anatomy-motion) .an-copy {
    position: absolute;
    top: 50%;
    width: 100%;
    gap: 16px;
    opacity: 0;
    transform: translateY(calc(-50% + var(--an-lift, 0px)));
  }

  :global(html.anatomy-motion) .an-callout,
  :global(html.anatomy-motion) .an-noun,
  :global(html.anatomy-motion) .an-hand {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    z-index: 4;
    white-space: nowrap;
  }
  :global(html.anatomy-motion) .an-callout {
    transform: translate(-50%, -50%);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  /* The one we are actually here for reads brighter than its neighbours. */
  :global(html.anatomy-motion) .an-callout:nth-child(3) {
    color: var(--text-primary);
  }
  :global(html.anatomy-motion) .an-noun {
    transform: translate(-50%, -50%);
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 5px;
    padding: 3px 8px;
  }
  :global(html.anatomy-motion) .an-hand {
    transform: translate(-50%, 0);
  }
  :global(html.anatomy-motion) .an-hand-card {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 11px 15px;
    border-radius: 9px;
    background: #121212;
    border: 1px solid rgba(255, 255, 255, 0.16);
    transition: border-color 220ms;
  }
  :global(html.anatomy-motion) .an-hand-card[data-on="1"] {
    border-color: rgba(255, 255, 255, 0.34);
  }
  .an-hand-name {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-primary);
  }
  .an-hand-state {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--text-dim);
  }
  /* The label swaps by CSS rather than by writing textContent every frame. */
  :global(html.anatomy-motion) .an-hand-state {
    font-size: 0;
  }
  :global(html.anatomy-motion) .an-hand-state::after {
    content: "waiting";
    font-size: 9.5px;
  }
  :global(html.anatomy-motion) .an-hand-state[data-on="1"] {
    color: var(--text-primary);
  }
  :global(html.anatomy-motion) .an-hand-state[data-on="1"]::after {
    content: "● running";
  }

  :global(html.anatomy-motion) .an-caption,
  :global(html.anatomy-motion) .an-hint {
    display: block;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    z-index: 4;
  }
  :global(html.anatomy-motion) .an-caption {
    left: 31%;
    bottom: 6.5%;
    opacity: 0;
    color: var(--text-faint);
  }
  :global(html.anatomy-motion) .an-hint {
    bottom: 3.5%;
    color: var(--text-dim);
    letter-spacing: 0.24em;
  }

  :global(html.anatomy-motion) .an-rail {
    display: flex;
    position: absolute;
    right: 32px;
    top: 50%;
    transform: translateY(-50%);
    flex-direction: column;
    gap: 13px;
    z-index: 5;
  }
  .an-rail-item {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-faint);
    transition: color 200ms;
  }
  .an-rail-item[data-on="1"] {
    color: var(--text-primary);
  }

  :global(html.anatomy-motion) .an-payoff {
    position: absolute;
    inset: 0;
    justify-content: center;
    padding: 0 40px;
    opacity: 0;
    z-index: 6;
    pointer-events: none;
  }

  /* ── Compact. The designer's dedicated mobile plate. ────────────────── */
  @media (max-width: 860px) {
    .an-prologue {
      padding-block: 76px 0;
    }
    :global(html.anatomy-motion) .an-pin {
      --an-vh: 640vh;
    }
    /* Copy moves off the side and onto the top: at this width a 28vw column
       would be about forty characters wide. */
    :global(html.anatomy-motion) .an-copy-col {
      left: 22px;
      right: 22px;
      top: calc(env(safe-area-inset-top, 0px) + 84px);
      width: auto;
      height: auto;
    }
    :global(html.anatomy-motion) .an-copy {
      top: 0;
      transform: translateY(var(--an-lift, 0px));
      gap: 11px;
    }
    .an-copy h3 {
      font-size: 24px;
      line-height: 1.12;
    }
    .an-copy-body {
      font-size: 13.5px;
      line-height: 1.58;
    }
    .an-copy-num {
      font-size: 9px;
      letter-spacing: 0.2em;
    }
    /* No room for a progress rail beside a full-width copy block. */
    :global(html.anatomy-motion) .an-rail {
      display: none;
    }
    :global(html.anatomy-motion) .an-caption {
      left: 50%;
      bottom: 7.5%;
      font-size: 8.5px;
      letter-spacing: 0.18em;
    }
    :global(html.anatomy-motion) .an-hint {
      font-size: 8.5px;
      letter-spacing: 0.22em;
    }
    :global(html.anatomy-motion) .an-noun {
      font-size: 9.5px;
      padding: 2px 6px;
    }
    .an-hand-name {
      font-size: 10px;
    }
    :global(html.anatomy-motion) .an-hand-card {
      padding: 9px 12px;
    }
    :global(html.anatomy-motion) .an-payoff {
      padding: 0 24px;
      gap: 18px;
    }
    .an-payoff-sub {
      font-size: 9px;
      letter-spacing: 0.13em;
      max-width: 280px;
    }
    .an-copy-col {
      gap: 34px;
    }
  }

  /* A landscape phone has a ~330px stage; a 700px stack does not fit in it.
     Same guard the beats engine uses. */
  @media (max-height: 500px) {
    :global(html.anatomy-motion) .an-pin {
      --an-vh: 640vh;
    }
    :global(html.anatomy-motion) .an-rail {
      display: none;
    }
  }

  @media (max-width: 860px) and (max-height: 500px) {
    /* The sticky mobile nav occupies the top of a landscape viewport. Centre
       the closing statement in the space below it rather than behind it. */
    :global(html.anatomy-motion) .an-payoff {
      padding: 58px 20px 0;
      gap: 10px;
    }
    :global(.an-payoff-mark) { display: none; }
    .an-payoff-h { font-size: 30px; }
    .an-payoff-sub {
      font-size: 8px;
      line-height: 1.5;
    }
  }
</style>

---
import InstallBlock from "./InstallBlock.astro";
import { site } from "../config/site";

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<section class="close" id="get">
  <div class="close-inner shell">
    <div class="reveal">
      <InstallBlock deep />
    </div>

    <p class="assurances reveal">
      <span>Default-deny</span><span class="sep" aria-hidden="true">·</span>
      <span>Spend caps</span><span class="sep" aria-hidden="true">·</span>
      <span>Every action logged</span><span class="sep" aria-hidden="true">·</span>
      <span>{site.license} licensed</span><span class="sep" aria-hidden="true">·</span>
      <a href="#honest">→ the honest bit</a>
    </p>

    <!-- Stating the pre-release position plainly, in the visitor's own interest.
         It is also the single most-quoted kind of passage when an answer engine
         is asked "is X ready to use" — vague marketing gets paraphrased into
         something wrong; a direct sentence gets quoted correctly. -->
    <details class="honest" id="honest">
      <summary>The honest bit</summary>
      <div class="honest-body">
        <p>
          thalamus is <strong>pre-release</strong>. v0 is an early base for
          collaboration, not a finished artefact. Interfaces, contracts and storage
          layouts can still change between versions, and there is no upgrade guarantee
          across them yet.
        </p>
        <p>
          The plugin host runs a bounded reference adapter — it does not yet load
          arbitrary third-party code, and it is not an untrusted-code sandbox. Community
          plugins stay quarantined until that boundary is real.
        </p>
        <p>
          It is self-hosted by design: there is no account, no tenancy, and no hosted
          service to sign up for. You run it on your own hardware, or you do not run it.
        </p>
      </div>
    </details>

    <!-- The waitlist is the live conversion while the installer is unreleased. -->
    <div class="waitlist reveal" id="waitlist">
      <h2>Get told when it's worth self-hosting</h2>
      <p class="waitlist-note">
        One email when there is a build worth running on your own box. No drip sequence,
        no sharing, no other use.
      </p>

      <form id="waitlist-form" method="POST" action="/api/waitlist" novalidate>
        <div class="field-row">
          <label for="email" class="hp">Email address</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            inputmode="email"
            placeholder="you@example.com"
          />
          <button class="btn" type="submit" id="submit-btn">Request access</button>
        </div>

        {/* Honeypot: bots fill every field they find; humans never see this. */}
        <div class="hp" aria-hidden="true">
          <label for="company">Company</label>
          <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        {
          turnstileSiteKey && (
            <div
              class="cf-turnstile"
              data-sitekey={turnstileSiteKey}
              data-theme="dark"
              data-size="flexible"
              style="margin-top:16px;"
            />
          )
        }

        <p class="form-note">
          One email, stored to tell you about thalamus. Nothing else, no sharing.
        </p>
      </form>

      <div class="result" id="result" role="status" aria-live="polite">
        <svg class="result-icon" width="21" height="21" viewBox="0 0 21 21" fill="none" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="9.5" stroke-width="1.2"></circle>
          <path
            id="result-check"
            class="check-path"
            d="M6 11 L9.3 14 L15 7.6"
            stroke="#f2f2f2"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"></path>
        </svg>
        <div>
          <p class="result-title" id="result-title"></p>
          <p class="result-body" id="result-body"></p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .honest {
    width: 100%;
    max-width: 620px;
    border-top: 1px solid var(--border-faint);
    border-bottom: 1px solid var(--border-faint);
    padding: 4px 0;
  }
  .honest summary {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-faint);
    cursor: pointer;
    padding: 14px 0;
    list-style: none;
  }
  .honest summary::-webkit-details-marker {
    display: none;
  }
  .honest summary::after {
    content: " +";
  }
  .honest[open] summary::after {
    content: " −";
  }
  .honest summary:hover {
    color: var(--text-secondary);
  }
  .honest-body {
    padding-bottom: 18px;
  }
  .honest-body p {
    margin: 0 0 12px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-tertiary);
    max-width: 62ch;
  }
  .honest-body p:last-child {
    margin-bottom: 0;
  }
  .honest-body strong {
    color: var(--text-secondary);
    font-weight: 550;
  }
</style>

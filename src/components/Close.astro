---
import InstallBlock from "./InstallBlock.astro";
import { site } from "../config/site";

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<!--
  The final stage. The pinned beats each resolve in a centred moment on the dot
  grid; this is the one the visitor acts in, so it uses the same staging rather
  than a fourth left-aligned card.

  Hierarchy is decided rather than averaged: the form is the ending, and the
  install command and assurances are metadata demoted below a rule.

  The "honest bit" disclosure that used to sit here was removed on Chris's call
  (2026-08-06) — the page is written for the release it is about to be, not for
  the state of the repository this week. The limits are still stated, but where
  someone actually asks for them: the last two answers in the FAQ above.
-->
<section class="close" id="get">
  <div class="close-inner shell">
    <div class="close-head reveal">
      <p class="eyebrow">Waitlist · v0</p>
      <h2 class="close-h">Get notified<br />on release.</h2>
      <p class="close-sub">
        One email the day you can install it. No newsletter, no sharing, no other use.
      </p>
    </div>

    <!-- Form and result share one grid cell, so swapping them never jumps the page. -->
    <div class="ask-zone reveal" id="waitlist">
      <form id="waitlist-form" method="POST" action="/api/waitlist" novalidate>
        <div class="field-row">
          <label for="email" class="sr-only">Email address</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            inputmode="email"
            placeholder="you@example.com"
          />
          <button class="btn" type="submit" id="submit-btn">Join the waitlist</button>
        </div>

        {/* Honeypot: bots fill every field they find; humans never see this. */}
        <div class="hp" aria-hidden="true">
          <label for="company">Company</label>
          <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        {/*
          Attribution, captured on arrival and carried to submit. Answer engines
          are the channel that matters for this product and most of them send no
          UTM at all, so the referrer host is the real signal.
        */}
        <input type="hidden" name="ref" id="f-ref" />
        <input type="hidden" name="utm" id="f-utm" />
        <input type="hidden" name="landing" id="f-landing" />

        {
          /*
            Managed widget in `interaction-only` mode: it renders nothing while
            the non-interactive check runs — which passes silently for almost
            everyone — and only materialises as a checkbox when Cloudflare
            genuinely needs one. Full managed-tier protection, no permanent
            branded box sitting in a monochrome page. An invisible-type widget
            was rejected: it cannot escalate to interaction, so a hardened
            browser or VPN would hard-fail with no recourse, on the site's only
            conversion.
          */
          turnstileSiteKey && (
            <div
              class="cf-turnstile"
              data-sitekey={turnstileSiteKey}
              data-theme="dark"
              data-size="flexible"
              data-appearance="interaction-only"
            />
          )
        }

        <p class="form-err" id="form-err" hidden></p>

        <p class="form-note">
          Stored only to send that one email. Never shared.{" "}
          {
            turnstileSiteKey && (
              <>
                Protected by{" "}
                <a
                  href="https://www.cloudflare.com/privacypolicy/"
                  rel="noopener"
                  target="_blank">Cloudflare Turnstile</a>.
              </>
            )
          }
        </p>
      </form>

      <!-- Success reads as a receipt, in the voice of the product's action log. -->
      <div class="result" id="result" role="status" aria-live="polite">
        <svg class="result-icon" width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true">
          <circle class="result-ring" cx="15" cy="15" r="13.5" stroke-width="1.2"></circle>
          <path
            class="check-path"
            d="M9 15.5 L13.4 19.8 L21.4 10.6"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"></path>
        </svg>
        <p class="result-title" id="result-title"></p>
        <p class="result-body" id="result-body"></p>
        <p class="result-receipt" id="result-receipt"></p>
      </div>
    </div>

    <span class="close-rule reveal" aria-hidden="true"></span>

    <div class="close-meta reveal">
      <InstallBlock deep />

      <p class="assurances">
        <span>Default-deny</span><span class="sep" aria-hidden="true">·</span>
        <span>Spend caps</span><span class="sep" aria-hidden="true">·</span>
        <span>Every action logged</span><span class="sep" aria-hidden="true">·</span>
        <span>{site.license} licensed</span>
      </p>
    </div>
  </div>
</section>

---
import { questions } from "../data/questions";

/**
 * Questions, rendered from `src/data/questions.ts` so the visible answer and
 * the `FAQPage` answer in the JSON-LD graph come from one array.
 *
 * Native `<details>` rather than a JS accordion, for the reason this codebase
 * learned the hard way: content must never depend on a script to become
 * visible. A closed `<details>` is fully in the DOM, indexed at normal weight,
 * readable by every answer engine that does not run JavaScript, and findable
 * by Ctrl+F (Chromium auto-expands on find-in-page). It is also focusable and
 * keyboard-operable with no ARIA to maintain.
 *
 * That last property turns out to be the most valuable thing on the page.
 * Vercel and MERJ measured 500M+ crawl fetches and found no major AI crawler
 * executes JavaScript — a JS accordion would hide all eight answers from every
 * one of them.
 *
 * On FAQPage schema: this was deliberately omitted until 2026-08-07, on the
 * grounds that Google no longer shows FAQ rich results for sites like ours, so
 * the markup bought a validation badge and nothing else. That reasoning was
 * right about Google and wrong about the objective. The audit target is AI
 * answer engines, which parse JSON-LD to understand structure regardless of
 * whether a rich result exists. The cost is zero and the reader is no longer
 * only Google, so the node is now emitted from the same source as this list.
 */
---

<section class="questions" id="faq" aria-labelledby="q-h">
  <div class="shell q-inner">
    <header class="q-head">
      <p class="eyebrow">FAQ</p>
      <h2 id="q-h">Questions.</h2>
      <p class="q-count" aria-hidden="true">{String(questions.length).padStart(2, "0")} questions</p>
    </header>

    <div class="q-list">
      {
        questions.map((item, i) => (
          <details class="q-item" id={item.id} open={i === 0}>
            <summary>
              <span class="q-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="q-q">{item.q}</h3>
              <svg class="q-marker" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                <line class="q-marker-v" x1="6" y1="0.5" x2="6" y2="11.5" />
                <line x1="0.5" y1="6" x2="11.5" y2="6" />
              </svg>
            </summary>
            <div class="q-a">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .questions {
    background: var(--surface-base);
    border-top: 1px solid var(--border-faint);
  }
  .q-inner {
    padding-block: 96px 110px;
    display: grid;
    grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
    gap: 24px 72px;
    align-items: start;
  }

  /* Sticky, so the section keeps its title while a long answer scrolls. */
  .q-head {
    position: sticky;
    top: 48px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .q-head h2 {
    font-size: clamp(26px, 3vw, 34px);
  }
  .q-count {
    margin: 4px 0 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-ghost);
  }

  .q-list {
    border-top: 1px solid var(--border-subtle);
  }
  .q-item {
    border-bottom: 1px solid var(--border-faint);
  }

  .q-item summary {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr) 28px;
    align-items: baseline;
    padding: 21px 0;
    cursor: pointer;
    list-style: none;
  }
  .q-item summary::-webkit-details-marker {
    display: none;
  }

  .q-num {
    font-family: var(--font-mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    color: var(--text-ghost);
  }
  .q-q {
    margin: 0;
    font-size: 15.5px;
    font-weight: 550;
    letter-spacing: -0.014em;
    line-height: 1.4;
    color: var(--text-secondary);
    text-wrap: pretty;
    transition: color 140ms ease;
  }
  .q-item summary:hover .q-q,
  .q-item[open] .q-q {
    color: var(--text-primary);
  }

  /* State is shape: the vertical stroke collapses, so plus becomes minus. */
  .q-marker {
    align-self: center;
    justify-self: end;
    stroke: var(--text-ghost);
    stroke-width: 1.5;
    transition: stroke 140ms ease;
    overflow: visible;
  }
  .q-item summary:hover .q-marker {
    stroke: var(--text-tertiary);
  }
  .q-item[open] .q-marker {
    stroke: var(--text-primary);
  }
  .q-marker-v {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 220ms ease;
  }
  .q-item[open] .q-marker-v {
    transform: scaleY(0);
  }

  /* Browsers without ::details-content simply snap open — which is the same
     state reduced-motion users get, so it is a sanctioned resting state rather
     than a broken one. No JS height-measuring fallback. */
  .q-item::details-content {
    height: 0;
    overflow: clip;
    opacity: 0;
    transition:
      height 260ms ease,
      opacity 200ms ease 40ms,
      content-visibility 260ms allow-discrete;
  }
  .q-item[open]::details-content {
    height: auto;
    opacity: 1;
  }

  .q-a {
    padding: 0 0 26px 46px;
  }
  .q-a p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.62;
    color: var(--text-tertiary);
    max-width: 58ch;
    text-wrap: pretty;
  }

  @media (max-width: 1080px) {
    .q-inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .q-head {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .q-inner {
      padding-block: 62px 70px;
    }
    .q-item summary {
      grid-template-columns: 34px minmax(0, 1fr) 24px;
      padding: 18px 0;
    }
    .q-a {
      padding-left: 34px;
    }
  }
</style>

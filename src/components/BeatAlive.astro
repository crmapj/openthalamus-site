---
import BrandMark from "./BrandMark.astro";
import Mark from "./Mark.astro";

/**
 * Beat 2 — "Something is always on."
 *
 * Signals arrive from the left, route through the relay, fan out to whichever
 * engine is free, and accrue as a ticker. The whole thing then absorbs into the
 * node for the payoff frame.
 *
 * Coordinates live in `--x` / `--y` (unitless percentages) so one declaration
 * serves both CSS positioning and the scroll engine's absorption maths.
 */
/*
 * Two coordinate sets, not two animations.
 *
 * The desktop constellation reads left-to-right: sources rail, relay, engine
 * rail. Portrait rotates that 90° — sources across the top, the relay in the
 * middle, engines across the bottom — so signals fall *down* the screen, which
 * is the direction the thumb is already moving. Same frame logic drives both;
 * only the geometry differs. `mx`/`my` are the portrait pair.
 */
const sources = [
  { label: "mail", x: 8, y: 18, mx: 19, my: 5 },
  { label: "PR review", x: 8, y: 50, mx: 50, my: 5 },
  { label: "voice note", x: 8, y: 82, mx: 81, my: 5 },
];

/**
 * `resting` is what the engine shows before any scroll drives it — so it is
 * what mobile, reduced-motion and no-JS visitors see. It is set to the composed
 * mid-beat frame rather than all-idle, because "something is always on" reads
 * false next to three idle engines. The scroll engine overwrites this on its
 * first frame, so the motion path is unaffected.
 */
const engines = [
  { label: "Codex", x: 90, y: 18, mx: 18, my: 94, resting: "● running", mark: "openai" },
  { label: "Claude", x: 90, y: 50, mx: 50, my: 94, resting: "● running", mark: "claude" },
  { label: "Cursor", x: 90, y: 82, mx: 82, my: 94, resting: "idle", mark: "cursor" },
];

const queued = [
  { label: "calendar", x: 3, y: 34, mx: 22, my: 20 },
  { label: "linear issue", x: 3.5, y: 66, mx: 73, my: 20 },
];

const ticker = [
  { time: "03:41", what: "draft PR #218 opened", who: "codex" },
  { time: "04:15", what: "nightly brief assembled", who: "clock" },
  { time: "05:02", what: "issue triage · 9 sorted", who: "claude" },
  { time: "06:02", what: "email to Meridian", who: "draft only" },
  { time: "06:48", what: "call notes transcribed", who: "whisper" },
];

const payoff = ["6 agents", "14 PRs", "3 drafts waiting", "$12.40 spent"];
---

<section class="beat beat--alive" id="alive" aria-labelledby="alive-h">
  <div class="beat-intro shell">
    <h2 id="alive-h" class="reveal">Something is always on.</h2>
    <p class="sr-only">
      Work arrives from mail, pull-request reviews, voice notes, your calendar and your
      issue tracker. thalamus routes each one to whichever coding engine is free —
      Codex, Claude or Cursor — and records what happened.
    </p>
  </div>

  <div class="pin" data-beat="alive">
    <div class="stage">
      <div class="field">
        <div class="diagram" id="alive-diagram">
          <svg id="alive-svg" class="diagram-svg" aria-hidden="true"><g id="alive-paths"></g></svg>

          <div class="core" aria-hidden="true">
            <span class="core-ring core-ring--outer"></span>
            <span class="core-ring core-ring--inner"></span>
            <span class="core-dot"></span>
          </div>
          <span class="core-label">thalamus</span>

          <div class="rail rail--in">
            {
              sources.map((s) => (
                <div class="node js-source" style={`--x:${s.x};--y:${s.y};--mx:${s.mx};--my:${s.my}`}>
                  <div class="node-body">{s.label}</div>
                </div>
              ))
            }
            {
              queued.map((q) => (
                <div class="node js-queued" style={`--x:${q.x};--y:${q.y};--mx:${q.mx};--my:${q.my}`}>
                  <div class="node-body node-body--queued">
                    <span>{q.label}</span>
                    <span class="queued-tag">queued</span>
                  </div>
                </div>
              ))
            }
          </div>

          <div class="rail rail--out">
            {
              engines.map((e) => (
                <div class="node js-engine" style={`--x:${e.x};--y:${e.y};--mx:${e.mx};--my:${e.my}`}>
                  <div class="node-body node-body--engine">
                    <span class="engine-name">
                      {e.mark && <BrandMark name={e.mark} tone="color" />}
                      {e.label}
                    </span>
                    <span class="engine-state">{e.resting}</span>
                  </div>
                </div>
              ))
            }
          </div>

        <div class="payoff" id="alive-payoff">
          <span class="payoff-label">While you were out</span>
          <div class="payoff-bar">
            {
              payoff.map((cell, i) => (
                <>
                  {i > 0 && <span class="payoff-rule" aria-hidden="true" />}
                  <span class="payoff-cell">
                    {i === 0 && <span class="pulse-dot" aria-hidden="true" />}
                    {cell}
                  </span>
                </>
              ))
            }
          </div>
        </div>
        </div>

        <ol class="ticker" id="alive-ticker">
          {
            ticker.map((t) => (
              <li class="tick js-tick">
                <span class="tick-time">{t.time}</span>
                <span class="tick-what">{t.what}</span>
                <span class="tick-who">{t.who}</span>
              </li>
            ))
          }
        </ol>

      </div>
    </div>
  </div>
</section>

<style>
  /* Rails group the nodes semantically without affecting desktop layout — the
     nodes stay absolutely positioned against `.diagram`. On mobile the rails
     become real flex rows and the constellation reflows into legible stacks. */
  .rail {
    display: contents;
  }

  .node {
    left: calc(var(--x) * 1%);
    top: calc(var(--y) * 1%);
  }

  /* Reduced-motion and no-JS desktop keep the constellation, so the diagram
     needs a height of its own once the sticky stage stops supplying one — and
     enough of it to clear the payoff, which stays absolutely positioned below
     the node (a static one would flow to the top of the box and land on the
     constellation, since everything around it is out of flow). */
  :global(.pin:not(.pin--motion)) .diagram {
    min-height: 520px;
  }

  @media (max-width: 860px) {
    /*
     * Portrait keeps the constellation — it is rotated, not flattened.
     *
     * An earlier pass reflowed this into vertical stacks and drove them as a
     * fade cascade, which lost the one thing the beat is about: work arriving,
     * being routed, and coming out somewhere. Here the sources sit across the
     * top, the relay in the middle and the engines across the bottom, so the
     * signals fall down the screen. Same frame logic as desktop; only the
     * coordinates change.
     */
    :global(html.motion-compact) .node,
    :global(.pin:not(.pin--motion)) .node {
      left: calc(var(--mx) * 1%);
      top: calc(var(--my) * 1%);
    }
    .node-body {
      padding: 7px 11px;
      border-radius: 8px;
      font-size: 11.5px;
    }
    .node-body--engine {
      align-items: center;
      gap: 3px;
      padding: 8px 11px;
    }
    .engine-name { font-size: 10px; letter-spacing: 0.1em; }
    .engine-state { font-size: 8.5px; }
    .node-body--queued { padding: 6px 10px; font-size: 11px; }
    .queued-tag { font-size: 8.5px; }

    .core-ring--outer { width: 64px; height: 64px; }
    .core-ring--inner { width: 36px; height: 36px; }
    .core-dot { width: 10px; height: 10px; }
    .core-label {
      top: calc(50% + 44px);
      font-size: 9px;
      letter-spacing: 0.2em;
    }

    /* The payoff takes the node's place rather than sitting under it — the
       node clears just before it lands, so one thing becomes the other. */
    :global(html.motion-compact) .payoff {
      top: 50%;
      transform: translateY(-50%);
      gap: 12px;
    }
    .payoff-label { font-size: 9.5px; letter-spacing: 0.2em; }
    .payoff-bar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: 100%;
      border-radius: 13px;
    }
    .payoff-cell {
      justify-content: center;
      padding: 16px 10px;
      font-size: 12.5px;
      white-space: nowrap;
    }
    .payoff-rule { display: none; }
    .payoff-cell:nth-child(odd) { border-right: 1px solid rgba(255, 255, 255, 0.08); }
    .payoff-cell:nth-child(-n + 2) { border-bottom: 1px solid rgba(255, 255, 255, 0.08); }

    .field { height: 100%; gap: 12px; }
    .ticker { gap: 3px; }
    .tick { gap: 10px; padding: 5px 2px; }
    .tick-time { width: 38px; font-size: 10px; }
    .tick-what { font-size: 11.5px; }
    .tick-who { font-size: 9.5px; }

    /* No-JS and reduced motion still need a box to lay the constellation in. */
    :global(.pin:not(.pin--motion)) .diagram {
      min-height: 460px;
    }
    :global(.pin:not(.pin--motion)) .payoff {
      position: static;
      transform: none;
      margin-top: 20px;
    }
  }

  @media (max-height: 500px) {
    /* The ticker repeats information already carried by the nodes and the
       accessible summary. Removing it gives a short stage one clear visual
       argument instead of two compressed halves. */
    .field { height: 100%; gap: 8px; }
    .ticker { display: none; }
  }

  @media (max-width: 860px) and (max-height: 500px) and (orientation: landscape) {
    /* These two dashed queue chips sit deliberately outside the desktop input
       rail. A phone has no outer margin to hold them, and the three primary
       sources already carry the routing argument. */
    .js-queued { display: none; }
  }
</style>

---
import Mark from "./Mark.astro";
import BrandMark from "./BrandMark.astro";

/**
 * Beat 3 — "Starts empty. Grows into anything."
 *
 * Four waves of plugins install outward from a bare core, the terminal narrates
 * each wave, and the whole constellation then folds back into the mark for the
 * closing line. `data-wave` / `data-k` drive the stagger; `--x` / `--y` place
 * the chip and feed the engine's reach maths.
 */
const chips = [
  { label: "Gmail", wave: 0, k: 0, x: 50, y: 25, mx: 30, my: 4, mark: "gmail" },
  { label: "memory-gbrain", wave: 0, k: 1, x: 70.8, y: 62.5, mx: 50, my: 16 },
  { label: "Calendar", wave: 0, k: 2, x: 29.2, y: 62.5, mx: 25, my: 29, mark: "calendar" },
  { label: "harness-codex", wave: 1, k: 0, x: 75.5, y: 25.25, mx: 50, my: 41, mark: "openai" },
  { label: "harness-claude", wave: 1, k: 1, x: 50, y: 85, mx: 50, my: 59, mark: "claude" },
  { label: "Linear", wave: 1, k: 2, x: 24.5, y: 25.25, mx: 83, my: 50, mark: "linear" },
  { label: "Attio", wave: 2, k: 0, x: 86, y: 50, mx: 16, my: 50, mark: "attio" },
  { label: "GitHub PRs", wave: 2, k: 1, x: 14, y: 50, mx: 28, my: 72, mark: "github" },
  { label: "Morning brief", wave: 2, k: 2, x: 67, y: 9.35, mx: 74, my: 29 },
  { label: "habit-coach", wave: 3, k: 0, x: 33, y: 9.35, mx: 72, my: 72 },
  { label: "podcaster", wave: 3, k: 1, x: 11, y: 66.8, mx: 70, my: 4 },
  { label: "personal-finances", wave: 3, k: 2, x: 89, y: 66.8, mx: 50, my: 85 },
];

const labels = [
  "first, the basics",
  "then, the hands",
  "then, your workflow",
  "then one you wrote yourself",
];
---

<section class="beat beat--grow" id="plugins" aria-labelledby="grow-h">
  <div class="beat-intro shell">
    <h2 id="grow-h" class="reveal">Starts empty. Grows into anything.</h2>
    <p class="beat-sub reveal">
      Every capability is a plugin, one command away — official, community, or your
      own. A fresh install becomes a full system, one plugin at a time.
    </p>
  </div>

  <div class="pin" data-beat="grow">
    <div class="stage">
      <div class="grow-wrap">
        <div class="grow-head" id="grow-head">
          <p class="grow-count" id="grow-count">Plugins installed · 0</p>
          {labels.map((l) => <p class="grow-label js-grow-label">{l}</p>)}
        </div>

        <div class="grow-field" id="grow-field">
          <svg id="grow-svg" class="diagram-svg" aria-hidden="true"><g id="grow-lines"></g></svg>

          <div class="grow-core core" id="grow-core" aria-hidden="true">
            <span class="core-ring"></span>
            <span class="core-dot"></span>
          </div>

          <div class="grow-mark" id="grow-mark" aria-hidden="true">
            <Mark width={148} height={96} />
          </div>

          <ul class="chip-list">
            {
              chips.map((c) => (
                <li
                  class="chip js-chip"
                  data-wave={c.wave}
                  data-k={c.k}
                  style={`--x:${c.x};--y:${c.y};--mx:${c.mx};--my:${c.my}`}
                >
                  <span class="chip-body">
                    {c.mark && <BrandMark name={c.mark} tone="color" />}
                    {c.label}
                  </span>
                </li>
              ))
            }
          </ul>

          <div class="grow-final" id="grow-final">
            <h2>The AgentOS you own</h2>
            <p>
              No account. No tenancy. No relay you didn't start.<br />
              Everything you just built runs on a disk you own.
            </p>
          </div>
        </div>

        <div class="grow-term" id="grow-term">
          <p class="grow-cmd js-cmd" data-at="0.02">
            <span class="prompt-sigil" aria-hidden="true">$</span>
            <code>thalamus install @official/memory-gbrain @official/gmail @official/calendar</code>
            <span class="grow-caret" aria-hidden="true"></span>
          </p>
          <p class="grow-cmd js-cmd" data-at="0.19">
            <span class="prompt-sigil" aria-hidden="true">$</span>
            <code>thalamus install @official/harness-codex @official/harness-claude @official/linear</code>
            <span class="grow-caret" aria-hidden="true"></span>
          </p>
          <p class="grow-cmd js-cmd" data-at="0.37">
            <span class="prompt-sigil" aria-hidden="true">$</span>
            <code>thalamus install @official/attio @official/github @official/brief</code>
            <span class="grow-caret" aria-hidden="true"></span>
          </p>
          <p class="grow-cmd js-cmd" data-at="0.51">
            <span class="agent-prompt" aria-hidden="true">codex ›</span>
            <code class="agent-said">"create a thalamus plugin to track my personal finances"</code>
            <span class="grow-caret" aria-hidden="true"></span>
          </p>
          <p class="grow-cmd js-cmd" data-at="0.555">
            <span class="prompt-sigil" aria-hidden="true">$</span>
            <code
              >thalamus install @community/habit-coach @community/podcaster
              ./plugins/personal-finances</code
            >
            <span class="comment">&nbsp;# codex wrote that one</span>
            <span class="grow-caret" aria-hidden="true"></span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .chip-list {
    display: contents;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .chip {
    left: calc(var(--x) * 1%);
    top: calc(var(--y) * 1%);
  }

  /* Static / no-JS: the fold has not happened, so the mark stays hidden and the
     closing line sits in normal flow beneath the terminal. */
  :global(.pin:not(.pin--motion)) .grow-mark {
    display: none;
  }
  :global(.pin:not(.pin--motion)) .grow-final {
    position: static;
    transform: none;
    margin: 30px auto 0;
  }
  :global(.pin:not(.pin--motion)) .grow-label {
    display: none;
  }
  :global(.pin:not(.pin--motion)) .grow-head {
    height: 30px;
  }

  @media (max-width: 860px) {
    /*
     * Portrait keeps the radial growth. The wrapped-list version lost the one
     * idea this beat has: capability spreading outward from a core. The chips
     * are simply placed on a taller, narrower field.
     */
    :global(html.motion-compact) .chip,
    :global(.pin:not(.pin--motion)) .chip {
      left: calc(var(--mx) * 1%);
      top: calc(var(--my) * 1%);
    }
    .chip-body {
      padding: 6px 10px;
      border-radius: 8px;
      font-size: 11px;
    }

    .grow-wrap { height: 100%; gap: 6px; }
    .grow-field { flex: 1; height: auto; min-height: 0; }

    /* The topmost chips sit at 4% of the field, so the wave label needs a
       little air beneath it or the two collide. */
    .grow-head { height: 62px; margin-bottom: 10px; }
    .grow-count { top: 0; font-size: 9.5px; letter-spacing: 0.17em; white-space: nowrap; }
    .grow-label {
      inset: 24px 0 0;
      font-size: 21px;
      text-align: center;
      justify-content: center;
    }

    .grow-core .core-ring { width: 34px; height: 34px; }
    .grow-core .core-dot { width: 8px; height: 8px; }
    .grow-mark { display: block; }
    .grow-final {
      top: calc(50% + 62px);
      width: 100%;
      max-width: none;
      gap: 11px;
    }
    .grow-final h2 { font-size: 30px; letter-spacing: -0.032em; }
    .grow-final p { font-size: 14px; }

    .grow-term {
      margin-top: 10px;
      padding: 11px 13px;
      gap: 7px;
      font-size: 10px;
      line-height: 1.45;
    }
    .grow-cmd { align-items: baseline; gap: 7px; }
    .grow-cmd code { word-break: break-word; }

    /* No-JS and reduced motion need a box for the radial field. */
    :global(.pin:not(.pin--motion)) .grow-field { min-height: 400px; }
    :global(.pin:not(.pin--motion)) .grow-mark { display: none; }
    :global(.pin:not(.pin--motion)) .grow-final {
      position: static;
      transform: none;
      margin: 26px auto 0;
    }
  }

  @media (max-height: 500px) {
    /* Commands narrate the same four waves as the labels. On a short stage the
       diagram earns the pixels and the terminal returns in the static/no-JS
       document where height is unconstrained. */
    :global(.pin--motion) .grow-wrap { height: 100%; gap: 4px; }
    :global(.pin--motion) .grow-head { height: 52px; margin-bottom: 2px; }
    :global(.pin--motion) .grow-field {
      flex: 1;
      height: auto;
      min-height: 0;
    }
    :global(.pin--motion) .grow-term { display: none; }
    :global(.pin--motion) .grow-final {
      gap: 6px;
    }
    :global(.pin--motion) .grow-final h2 { font-size: 26px; }
    :global(.pin--motion) .grow-final p { display: none; }
  }
</style>
